<?xml version="1.0" encoding="utf-8"?>
<!-- Pop-up for the eBay sold-price check. The listing draft stays exactly
     where it was underneath; closing this returns to it untouched. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <Button
        android:id="@+id/btn_back_to_listing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:text="Back to listing"
        android:textSize="18sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center"
        android:text="Sold prices on eBay"
        android:textSize="14sp" />

    <WebView
        android:id="@+id/popup_webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
