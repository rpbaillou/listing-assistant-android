<?xml version="1.0" encoding="utf-8"?>
<!-- v20: native top bar above the WebView. The framework Toolbar hosts the
     app title and the overflow (three-dot) menu, so settings actions live
     in native UI that cannot be clipped the way the old web header buttons
     were on a narrow phone screen. The WebView header below is a plain
     title bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <android.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:background="#0f2a44"
        android:title="Listing Assistant"
        android:titleTextColor="#ffffff" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <!-- The app itself, served from the phone. Hidden until the server is up. -->
    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Shown while the Python server starts. -->
    <TextView
        android:id="@+id/starting_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Starting Listing Assistant..."
        android:textSize="18sp"
        android:visibility="gone" />

    <!-- First-run key entry. Shown only when no keys are saved yet. -->
    <ScrollView
        android:id="@+id/setup_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/setup_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="One-time setup"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/setup_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:text="Enter your 7 keys once. They stay on this phone and are never sent anywhere except eBay and Google." />

            <EditText
                android:id="@+id/et_gemini"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Gemini API key (free key from Google AI Studio)"
                android:inputType="text" />

            <EditText
                android:id="@+id/et_client_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="eBay App ID (from developer.ebay.com)"
                android:inputType="text" />

            <EditText
                android:id="@+id/et_client_secret"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="eBay Cert ID (the secret one, never share it)"
                android:inputType="textPassword" />

            <EditText
                android:id="@+id/et_runame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="RuName (looks like Reynard_Baillou-ReynardB-Mr-PRD-...)"
                android:inputType="text" />

            <EditText
                android:id="@+id/et_fulfillment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Shipping policy ID (number from Seller Hub, Business policies)"
                android:inputType="number" />

            <EditText
                android:id="@+id/et_payment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Payment policy ID (number from Business policies)"
                android:inputType="number" />

            <EditText
                android:id="@+id/et_return"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Return policy ID (number from Business policies)"
                android:inputType="number" />

            <Button
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Save and start" />

            <!-- v19: shown only when editing saved keys (never on first
                 run, where there is nothing to go back to). -->
            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Cancel"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <!-- v44: in-app camera (CameraX). Stays open for rapid multi-shot:
         the shutter saves a photo at once, no review screen, no check.
         Done closes back to the listing. Hidden until Take photo. -->
    <FrameLayout
        android:id="@+id/camera_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <androidx.camera.view.PreviewView
            android:id="@+id/camera_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/camera_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="16dp"
            android:background="#80000000"
            android:padding="8dp"
            android:text="0 photos"
            android:textColor="#ffffff"
            android:textSize="16sp" />

        <Button
            android:id="@+id/camera_shutter"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="32dp"
            android:background="@drawable/shutter_button"
            android:contentDescription="Take photo"
            android:text="" />

        <Button
            android:id="@+id/camera_done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:background="#80000000"
            android:text="Done"
            android:textColor="#ffffff" />

    </FrameLayout>

    </FrameLayout>

</LinearLayout>
