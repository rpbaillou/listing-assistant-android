<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the app install its own updates. The matching "Allow from this
         source" toggle is per-app: granting it for Chrome does NOT grant it
         for us, so the updater checks canRequestPackageInstalls() up front. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- INTERNET is for the Gemini and eBay cloud APIs. The app's own server
         only ever talks to this phone (http://127.0.0.1:5050). usesCleartextTraffic
         allows that loopback HTTP connection on Android 9+. -->
    <application
        android:label="Listing Assistant"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Serves downloaded update APKs to the package installer. -->
        <provider
            android:name=".ApkFileProvider"
            android:authorities="${applicationId}.apkprovider"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!-- Serves the in-app camera's temp photo to the camera app (write)
             and back to our WebView file picker (read). No CAMERA permission
             needed: the camera app does the capturing. -->
        <provider
            android:name=".CameraPhotoProvider"
            android:authorities="${applicationId}.cameraprovider"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!-- Fires when an update APK finishes downloading, even if the app
             was closed or swiped away. Matches the download by the ID saved
             when Update was tapped; anything else is ignored. -->
        <receiver
            android:name=".UpdateDownloadReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
